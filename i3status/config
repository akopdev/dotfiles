general {
    color_degraded = "#cb4b16"
    output_format = "i3bar"
    interval = "5"
    color_bad = "#dc322f"
    colors = "true"
    color_good = "#859900"
    color_separator = "#586e75"
}

battery all {
    threshold_type = "time"
    integer_battery_capacity = "true"
    format = " %status  %percentage "
    format_down = ""
    status_chr = ""
    status_bat = ""
    status_unk = ""
    status_full = ""
    path = "/sys/class/power_supply/BAT%d/uevent"
    low_threshold = 10
}

volume master {
    device = "default"
    mixer_idx = "0"
    mixer = "Master"
    format = "  ♪ %volume "
}

time {
    format = "%A, %d %B %H:%M "
}

wireless _first_ {
  format_up = "  %quality "
  format_down = "  "
}

read_file kbd_layout {
    format = " %content "
    format_bad = " US "
    path = "/tmp/i3status-kbd-layout"
}

order += "read_file kbd_layout"
order += "battery all"
order += "volume master"
order += "wireless _first_"
order += "time"
