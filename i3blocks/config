command=$XDG_CONFIG_HOME/i3blocks/scripts/$BLOCK_NAME
markup=pango
separator=true
separator_block_width=20

[kbd_layout]
command=xkb-switch | tr '[:lower:]' '[:upper:]'
label= 
interval=1

[syncthing]
command=if /home/linuxbrew/.linuxbrew/bin/syncthing cli show system >/dev/null 2>&1; then printf '󰓦\n\n#859900\n'; else printf '󰓧\n\n#dc322f\n'; fi
interval=10

[battery]
command=acpi | grep -oP '\d+%'
label= 
interval=30

[volume]
command=wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{vol=int($2*100); print vol "%"}'
label=󰕾
interval=1
signal=1

[wireless]
command=awk 'NR==3 {sub(/\.$/, "%", $3); print $3}' /proc/net/wireless
label= 
interval=10

[time]
command=date '+%A, %d %B %H:%M  '
interval=5
