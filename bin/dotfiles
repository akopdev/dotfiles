#!/usr/bin/env bash

###################################################################################################
# Prepare environment 
###################################################################################################

DOTFILES="${HOME}/.dotfiles"
GREEN='\033[1;32m'
RED='\033[1;31m'
RESET='\033[0m'
YELLOW='\033[1;33m'

###################################################################################################
# Utils
###################################################################################################

info() {
  if [[ $LOG_LEVEL -ge $LOG_LEVEL_INFO ]]; then
    echo -e "${GREEN}[+]${RESET} $*" 1>&2
  fi
}

warn() {
  if [[ $LOG_LEVEL -ge $LOG_LEVEL_WARNING ]]; then
    echo -e "${YELLOW}[!]${RESET} $*" 1>&2
  fi
}

error() {
  if [[ $LOG_LEVEL -ge $LOG_LEVEL_ERROR ]]; then
    echo -e "${RED}[X]${RESET} $*" 1>&2
  fi
}


link_dir() {
  if [ ! -d "${HOME}/.config/${1}" ]; then
    ln -s "${DOTFILES}/${1}" "${HOME}/.config/${1}"
  fi
}

link_file() {
  local folder_name="${1%%/*}"
  local file_name="${1#"${folder_name}/"}"
  local destination="${2:-${HOME}/${file_name}}"
  if [ ! -f "${destination}" ]; then
    mkdir -p "$(dirname "${destination}")"
    ln -s "${DOTFILES}/${1}" "${destination}"
  fi
}

###################################################################################################
# Configuring installed apps to use dotfiles configs
###################################################################################################

_install_config_files() {
  # create a private gitconfig in user folder
  if [[ ! -f "${HOME}/.gitconfig.local" ]]; then
    cp "${DOTFILES}/git/gitconfig.local.example" "${HOME}/.gitconfig.local"
  fi

  # create Go folders if required
  if [[ ! -d "${HOME}/go" ]]; then
      mkdir -p "${HOME}"/go/{bin,src,pkg}
  fi

  link_dir "bat"
  link_dir "nvim"
  link_dir "pgcli"
  link_dir "ghostty"
  link_dir "profanity"
  link_dir "i3"
  link_dir "i3status"
  link_dir "i3blocks"
  link_dir "rofi"

  link_file "git/.gitconfig"
  link_file "tmux/.tmux.conf"
  link_file "zsh/.zshrc"
  link_file "wezterm/.wezterm.lua"
  link_file "vi/.exrc"
  link_file "aerospace/.aerospace.toml"
  link_file "claude/settings.json" "${HOME}/.claude/settings.json"
  link_file "bibtool/.bibtoolrsc"
}

###################################################################################################
# Update all installed packages
###################################################################################################

_fix_brew_trust_store() {
  local trust_dir="${HOMEBREW_USER_CONFIG_HOME:-${HOME}/.homebrew}"

  # Homebrew refuses to write to this directory if it's group or world writtable
  if [[ -d "${trust_dir}" ]]; then
    chmod go-w "${trust_dir}"
  fi
}

_update() {
  # Should not be a root user
  if [[ $(id -u) == 0 ]]; then
    error "Don't run this script as root!"
    return 1
  fi

  # Check if dotfiles exists
  if [[ ! -d "${DOTFILES}" ]]; then
    error "'${DOTFILES}' not found. Please, run install.sh first!"
    return 1
  fi

  local skip_brewing=false
  for arg in "$@"; do
    if [[ "${arg}" == "--skip-brewing" ]]; then
      skip_brewing=true
    fi
  done

  info "Get latest version of dotfiles."
  if ! cd "${DOTFILES}" || ! git pull; then
    error "Failed to pull latest dotfiles. Aborting."
    return 1
  fi

  if [[ "${skip_brewing}" == false ]]; then
    info "Updating system packages."
    OS="$(uname)"
    if [[ "${OS}" == "Linux" ]]; then
      if ! sudo apt-get update || ! sudo apt-get -y upgrade; then
        error "Failed to update system packages. Aborting."
        return 1
      fi
    fi

    _fix_brew_trust_store

    if ! brew update; then
      error "'brew update' failed. Aborting."
      return 1
    fi

    info "Clean local cache"
    if ! brew update-reset; then
      error "'brew update-reset' failed. Aborting."
      return 1
    fi

    info "Update all existing packages."
    if ! brew upgrade; then
      error "'brew upgrade' failed. Aborting."
      return 1
    fi

    info "Install new packages."
    if ! brew bundle; then
      error "'brew bundle' failed. Aborting."
      return 1
    fi

    info "Clean up installation."
    if ! brew cleanup; then
      error "'brew cleanup' failed. Aborting."
      return 1
    fi
  fi

  info "Install custom configurations."
  _install_config_files

  info "Update was successfully completed!"
}

###################################################################################################
# Open dotfiles in editor 
###################################################################################################

_open() {
  cd "${ZSH}" && ${EDITOR} ./nvim/init.lua
}

###################################################################################################
# Show help
###################################################################################################
_help() {
cat << HELP
 _____        _    __ _ _           
|  __ \      | |  / _(_) |          
| |  | | ___ | |_| |_ _| | ___  ___ 
| |  | |/ _ \| __|  _| | |/ _ \/ __|
| |__| | (_) | |_| | | | |  __/\__ \ 
|_____/ \___/ \__|_| |_|_|\___||___/

by Akop Kesheshyan

Usage: dotfiles [--update [--skip-brewing]] [--help]

Commands:
    --update              Update all installed packages
    --help                Show this help message

Options:
    --skip-brewing        Update without running brew commands

HELP
return 
}


###################################################################################################
# Entrypoint 
###################################################################################################

_main() {
  local cmd=""
  local extra_args=()

  for arg in "$@"; do
    case "${arg}" in
      --help|-h )      cmd="help" ;;
      --update )       cmd="update" ;;
      --skip-brewing ) extra_args+=("${arg}") ;;
      * )
        error "Unknown option: ${arg}"
        _help
        return 1
        ;;
    esac
  done

  case "${cmd}" in
    "" )      _open ;;
    help )    _help ;;
    update )  _update "${extra_args[@]}" ;;
  esac
}
_main "$@"
